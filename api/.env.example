# TaxOps API — Variables de entorno
# Copia este archivo como .env y rellena los valores

# ── Base de datos (Neon gratis: https://neon.tech) ────────────────────────────
DATABASE_URL=postgresql://taxops:taxops_dev_pass@localhost:5432/taxops

# ── JWT — CAMBIA SECRET_KEY en producción ────────────────────────────────────
SECRET_KEY=CAMBIA_ESTO_EN_PRODUCCION_MIN_32_CHARS_AQUI_ABC123
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS — URLs permitidas del frontend ───────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://taxops-web.vercel.app

# ── AI Providers ─────────────────────────────────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Superadmin ────────────────────────────────────────────────────────────────
TAXOPS_SUPERADMIN_EMAILS=tu@email.com
